# OpenPal server config example
# cp .env.example .env  and edit

PAL_HOST=0.0.0.0
PAL_PORT=8080

# ---- LLM (any OpenAI-compatible) ----
# DeepSeek
PAL_LLM_BASE_URL=https://api.deepseek.com/v1
PAL_LLM_API_KEY=
PAL_LLM_MODEL=deepseek-chat
PAL_LLM_TIMEOUT_SECONDS=60
PAL_LLM_MAX_TOKENS=512

# Local Ollama example:
# PAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# PAL_LLM_API_KEY=ollama
# PAL_LLM_MODEL=qwen2.5:7b

# ---- ASR ----
# disabled | openai | whisper_local
PAL_ASR_PROVIDER=disabled
PAL_ASR_BASE_URL=https://api.openai.com/v1
PAL_ASR_API_KEY=
PAL_ASR_MODEL=whisper-1
PAL_ASR_LANGUAGE=zh

# ---- TTS ----
# edge | openai | silent
PAL_TTS_PROVIDER=edge
PAL_TTS_VOICE=zh-CN-XiaoxiaoNeural
# OpenAI TTS requires PAL_TTS_API_KEY; edge requires ffmpeg.
# PAL_TTS_API_KEY=
# PAL_TTS_OPENAI_VOICE=alloy

# ---- audio / limits ----
PAL_SAMPLE_RATE_IN=16000
PAL_SAMPLE_RATE_OUT=24000
PAL_VAD_ENERGY_THRESHOLD=0.012
PAL_MIN_UTTERANCE_MS=250
PAL_MAX_UTTERANCE_MS=15000
PAL_AUDIO_CHUNK_BYTES=4096
PAL_MAX_CLIENTS=16
# Disabled by default because this endpoint aggregates text from all sessions.
PAL_EXPOSE_HISTORY=false

# ---- personality ----
PAL_PERSONA_NAME=小帕
