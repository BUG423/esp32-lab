# OpenPal server config example
# cp .env.example .env  and edit

PAL_HOST=0.0.0.0
PAL_PORT=8080

# ---- LLM (any OpenAI-compatible) ----
# DeepSeek
PAL_LLM_BASE_URL=https://api.deepseek.com/v1
PAL_LLM_API_KEY=
PAL_LLM_MODEL=deepseek-chat

# Local Ollama example:
# PAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# PAL_LLM_API_KEY=ollama
# PAL_LLM_MODEL=qwen2.5:7b

# ---- ASR ----
# disabled | openai | whisper_local
PAL_ASR_PROVIDER=disabled
PAL_ASR_BASE_URL=https://api.openai.com/v1
PAL_ASR_API_KEY=
PAL_ASR_MODEL=whisper-1
PAL_ASR_LANGUAGE=zh

# ---- TTS ----
# edge | openai | silent
PAL_TTS_PROVIDER=edge
PAL_TTS_VOICE=zh-CN-XiaoxiaoNeural

# ---- personality ----
PAL_PERSONA_NAME=小帕
