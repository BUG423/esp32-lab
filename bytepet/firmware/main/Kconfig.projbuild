menu "bytepet Configuration"

    config BYTEPET_WIFI_SSID
        string "WiFi SSID"
        default ""
        help
            SSID of the WiFi network to join. Leave empty to start
            a soft-AP named "bytepet-setup" instead.

    config BYTEPET_WIFI_PASS
        string "WiFi password"
        default ""
        help
            Password for the WiFi network. Leave empty for open networks.

    config BYTEPET_BUTTON_GPIO
        int "Button GPIO number"
        range 0 39
        default 0
        help
            GPIO connected to the physical button (active-low, internal pull-up).

    config BYTEPET_TICK_PERIOD_MS
        int "Pet tick period (ms)"
        range 100 60000
        default 1000
        help
            How often the pet tick task wakes up. One virtual minute
            is always 60000 ms of wall time regardless of this value.

endmenu
